---
import Base from '../layouts/Base.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import Pending from '../components/ui/Pending.astro';
import { sections, useTranslations } from '../i18n/ui';
import { site } from '../site';

const lang = 'es';
const t = useTranslations(lang);
---

<Base title={site.name} lang={lang}>
  <section class="hero container" aria-labelledby="hero-title">
    <h1 id="hero-title">{site.name}</h1>
    <Pending label="Hero: titular, subtítulo, CTAs, veredicto y franja de pruebas (F2)." />
  </section>

  {
    sections.map((section) => (
      <section id={section.id[lang]} class="section" aria-labelledby={`${section.id[lang]}-title`}>
        <div class="container">
          <SectionHeader letter={section.letter} title={t(section.key)} id={`${section.id[lang]}-title`} />
          <Pending label={`Contenido de ${t(section.key)} (F2).`} />
        </div>
      </section>
    ))
  }
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-block: var(--space-24) var(--section-pad);
  }
</style>

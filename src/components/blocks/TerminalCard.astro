---
import Icon from '../ui/Icon.astro';

interface Props {
  project: string;
  command: string;
  result: string;
}

const { project, command, result } = Astro.props;
---

<div class="term">
  <p class="term__project">{project}</p>
  <p class="term__cmd"><span aria-hidden="true">$</span> {command}</p>
  <p class="term__result">
    <Icon name="check" size={18} />
    {result}
  </p>
</div>

<style>
  .term {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-6);
    border: 1px solid var(--code-line);
    border-radius: var(--radius-3);
    background: var(--code-bg);
    font-family: var(--font-mono-stack);
    font-size: var(--fs-small);
  }

  .term__project {
    color: var(--code-muted);
    font-size: var(--fs-label);
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
  }

  .term__cmd {
    color: var(--code-text);
  }

  .term__cmd span {
    color: var(--code-ann);
  }

  .term__result {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--code-ann);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .term__result {
      animation: term-in 300ms var(--ease) backwards;
      animation-delay: 1.1s;
    }
  }

  @keyframes term-in {
    from {
      opacity: 0;
      transform: translateX(-6px);
    }
  }
</style>

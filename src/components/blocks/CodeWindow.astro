---
interface Props {
  file: string;
  lines: Array<Array<{ t: string; c: string }>>;
  /** Screen-reader description: the snippet itself is decorative. */
  label: string;
}

const { file, lines, label } = Astro.props;
---

<figure class="code" aria-label={label}>
  <div class="code__bar">
    <span></span><span></span><span></span>
    <figcaption>{file}</figcaption>
  </div>
  <pre class="code__body" aria-hidden="true">{lines.map((line, index) => (
    <span class="code__line" style={`--i: ${index}`}><span class="code__gutter">{index + 1}</span>{line.map((token) => (
      <span class={`code__t code__t--${token.c}`}>{token.t}</span>
    ))}{index === lines.length - 1 && <span class="code__caret" />}</span>
  ))}</pre>
</figure>

<style>
  .code {
    margin: 0;
    border: 1px solid var(--code-line);
    border-radius: var(--radius-3);
    background: linear-gradient(180deg, var(--code-bg-2), var(--code-bg));
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  .code__bar {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--code-line);
  }

  .code__bar span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: #2b3442;
  }

  figcaption {
    margin-inline-start: var(--space-3);
    color: var(--code-muted);
    font-family: var(--font-mono-stack);
    font-size: var(--fs-label);
  }

  .code__body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin: 0;
    padding: var(--space-4) var(--space-4) var(--space-6);
    font-family: var(--font-mono-stack);
    font-size: 0.8125rem;
    line-height: 1.7;
    color: var(--code-text);
    overflow-x: auto;
  }

  .code__gutter {
    display: inline-block;
    width: 2ch;
    color: var(--code-gutter);
  }

  .code__t--kw {
    color: var(--code-kw);
  }
  .code__t--ann {
    color: var(--code-ann);
  }
  .code__t--str {
    color: var(--code-str);
  }
  .code__t--fn {
    color: var(--code-fn);
  }
  .code__t--pun {
    color: var(--code-muted);
  }

  .code__caret {
    display: inline-block;
    width: 0.55ch;
    height: 1.05em;
    margin-inline-start: 0.2ch;
    background: var(--code-ann);
    vertical-align: -0.2em;
  }

  /* The snippet types itself in, one line at a time, then the caret blinks. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .code__line {
      animation: code-line 320ms var(--ease) backwards;
      animation-delay: calc(220ms + var(--i) * 130ms);
    }

    .code__caret {
      animation: code-caret 1.1s steps(1) infinite;
      animation-delay: 1.2s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .code__caret {
      opacity: 0.6;
    }
  }

  @keyframes code-line {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @keyframes code-caret {
    50% {
      opacity: 0;
    }
  }
</style>

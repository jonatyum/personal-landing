---
import Badge from '../ui/Badge.astro';
import { useTranslations, type Lang } from '../../i18n/ui';

interface Props {
  lang: Lang;
  label: string;
  cases: string[];
  result: string;
}

const { lang, label, cases, result } = Astro.props;
const t = useTranslations(lang);
---

<figure class="verdict" aria-label={label}>
  <figcaption class="label verdict__caption">{label}</figcaption>
  <ol role="list" class="verdict__cases">
    {
      cases.map((item, index) => (
        <li class="verdict__case">
          <span class="verdict__index" aria-hidden="true">
            {t('verdict.case')} {index + 1}
          </span>
          <span class="verdict__name">{item}</span>
          <span class="verdict__dots" aria-hidden="true" />
          <span class="verdict__ok">OK</span>
        </li>
      ))
    }
  </ol>
  <p class="verdict__result">
    <span class="verdict__result-label" aria-hidden="true">{t('verdict.result')}:</span>
    <Badge variant="verdict">{result}</Badge>
  </p>
</figure>

<style>
  .verdict {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-3);
    background: var(--surface);
    font-family: var(--font-mono-stack);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
  }

  .verdict__cases {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .verdict__case {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .verdict__index {
    flex-shrink: 0;
    color: var(--text-muted);
  }

  .verdict__name {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .verdict__dots {
    flex: 1;
    min-width: var(--space-4);
    border-bottom: 1px dotted var(--border-strong);
    transform: translateY(-0.3em);
  }

  .verdict__ok {
    color: var(--ok);
    font-weight: 500;
  }

  .verdict__result {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border-subtle);
    color: var(--text-muted);
  }
</style>

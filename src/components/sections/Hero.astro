---
import Button from '../ui/Button.astro';
import Badge from '../ui/Badge.astro';
import CodeWindow from '../blocks/CodeWindow.astro';
import TerminalCard from '../blocks/TerminalCard.astro';
import { sectionId, langHome, useTranslations, type Lang } from '../../i18n/ui';
import { pick, single } from '../../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const hero = await single('hero');
const site = await single('site');
const href = (section: typeof hero.primaryCta.section) =>
  `${langHome(lang)}#${sectionId(`section.${section}`, lang)}`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="hero__fade" aria-hidden="true"></div>
  <div class="hero__grid container">
    <div class="hero__copy">
      <div class="hero__meta">
        <p class="label">{pick(hero.eyebrow, lang)}</p>
        <Badge>{pick(site.availability, lang)}</Badge>
      </div>
      <h1 id="hero-title">
        {pick(hero.title, lang)}{' '}
        <span class="grad">{pick(hero.titleAccent, lang)}</span>
      </h1>
      <p class="lead hero__subtitle">{pick(hero.subtitle, lang)}</p>
      <div class="cluster hero__ctas">
        <Button href={href(hero.primaryCta.section)}>{pick(hero.primaryCta.label, lang)}</Button>
        <Button variant="secondary" href={href(hero.secondaryCta.section)} icon="arrow-right">
          {pick(hero.secondaryCta.label, lang)}
        </Button>
      </div>
      <ul role="list" class="hero__tech label">
        {hero.tech.map((item) => <li>{item}</li>)}
      </ul>
    </div>

    <div class="hero__visual">
      <CodeWindow
        file={hero.code.file}
        lines={hero.code.lines}
        label={`${hero.code.file}, ${t('code.example')}`}
      />
      <TerminalCard
        project={hero.terminal.project}
        command={hero.terminal.command}
        result={pick(hero.terminal.result, lang)}
      />
    </div>
  </div>

  <dl class="hero__proofs container">
    {
      hero.proofs.map((proof, index) => (
        <div class="hero__proof" data-reveal style={`--reveal-delay: ${index}`}>
          <dt>{pick(proof.value, lang)}</dt>
          <dd>{pick(proof.label, lang)}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .hero {
    position: relative;
    padding-block: var(--space-12) var(--section-pad);
    overflow: clip;
  }

  /* Blue glow plus a faint grid, both purely decorative. */
  .hero__glow {
    position: absolute;
    inset: -12rem 0 auto 0;
    height: 38rem;
    background:
      radial-gradient(42% 45% at 28% 50%, var(--glow), transparent 72%),
      linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0 / 72px 72px,
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0 / 72px 72px;
    pointer-events: none;
  }

  /* Fades the grid out towards the content instead of masking it (much cheaper to paint). */
  .hero__fade {
    position: absolute;
    inset: 6rem 0 auto 0;
    height: 20rem;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }

  .hero > *:not(.hero__glow):not(.hero__fade) {
    position: relative;
  }

  /* The glow drifts up and dims as the page scrolls away, so the hero feels like a layer
     the content slides over rather than a static banner. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .hero__glow {
        animation-name: glow-drift;
        animation-duration: auto;
        animation-fill-mode: both;
        animation-timing-function: linear;
        animation-timeline: view();
        animation-range: exit-crossing 0% exit 100%;
      }
    }
  }

  @keyframes glow-drift {
    to {
      translate: 0 -4rem;
      opacity: 0.15;
    }
  }

  /* First paint: the copy rises in on its own, without waiting for the reveal observer. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.js) .hero__copy > *,
    :global(html.js) .hero__visual > * {
      animation: hero-in var(--dur-3) var(--ease) both;
      animation-delay: calc(var(--hero-step, 0) * 80ms);
    }

    .hero__meta {
      --hero-step: 0;
    }

    h1 {
      --hero-step: 1;
    }

    .hero__subtitle {
      --hero-step: 2;
    }

    .hero__ctas {
      --hero-step: 3;
    }

    .hero__tech {
      --hero-step: 4;
    }

    .hero__visual > :first-child {
      --hero-step: 2;
    }

    .hero__visual > :last-child {
      --hero-step: 3;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: var(--space-12) var(--gutter);
    align-items: center;
    padding-block: var(--space-12) var(--space-16);
  }

  .hero__copy,
  .hero__visual {
    grid-column: 1 / -1;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .hero__subtitle {
    max-width: 48ch;
  }

  .hero__ctas {
    --cluster-gap: var(--space-3);
  }

  .hero__tech {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-6);
    padding-top: var(--space-2);
  }

  .hero__visual {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .hero__proofs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    padding: 1px;
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-3);
    background: var(--border-subtle);
    overflow: hidden;
  }

  .hero__proof {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-6);
    background: var(--bg);
  }

  .hero__proof dt {
    font-family: var(--font-display-stack);
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .hero__proof dd {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
  }

  @media (min-width: 1024px) {
    .hero__grid {
      padding-block: var(--space-16) var(--space-24);
    }

    .hero__copy {
      grid-column: 1 / span 6;
    }

    .hero__visual {
      grid-column: 7 / span 6;
    }

    .hero__proofs {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>

---
import Section from '../layout/Section.astro';
import Tag from '../ui/Tag.astro';
import Pending from '../ui/Pending.astro';
import type { Lang } from '../../i18n/ui';
import { pick, single } from '../../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const experience = await single('experience');
---

<Section name="experience" lang={lang}>
  <ol role="list" class="jobs" data-stagger>
    {
      experience.jobs.map((job, index) => (
        <li class="job">
          <p class="job__period label">
            <time datetime={job.start}>{pick(job.period, lang)}</time>
          </p>
          <div class="job__body">
            <h3>{pick(job.role, lang)}</h3>
            <p class="job__org">
              {job.org}
              {job.orgDetail && <span class="muted"> · {pick(job.orgDetail, lang)}</span>}
            </p>
            <p>{pick(job.summary, lang)}</p>
            {job.achievements.length > 0 && (
              <ul class="job__achievements">
                {job.achievements.map((item) => (
                  <li>{pick(item, lang)}</li>
                ))}
              </ul>
            )}
            {index === 0 && job.achievements.length === 0 && (
              <Pending label="Logros concretos con cifras y confirmar qué se puede nombrar por el NDA." />
            )}
          </div>
        </li>
      ))
    }
  </ol>

  <div class="stack-block">
    <h3>{pick(experience.stackTitle, lang)}</h3>
    <dl class="stack-groups" data-stagger>
      {
        experience.stack.map((group) => (
          <div class="stack-group">
            <dt class="label">{pick(group.label, lang)}</dt>
            <dd>
              <ul role="list" class="cluster stack-group__items">
                {group.items.map((item) => (
                  <Tag>{item}</Tag>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</Section>

<style>
  /* A timeline: one line down the left, a node per job. It turns the empty half of the
     old two-column layout into structure, and continues the rail the section opens with. */
  .jobs {
    position: relative;
    display: flex;
    flex-direction: column;
    padding-inline-start: var(--space-8);
  }

  .jobs::before {
    content: '';
    position: absolute;
    inset-block: 0.75rem;
    inset-inline-start: 3px;
    width: 1px;
    background: linear-gradient(to bottom, var(--accent), var(--border-subtle));
  }

  .job {
    position: relative;
    display: grid;
    gap: var(--space-2) var(--gutter);
    padding-block: var(--space-8);
  }

  .job::before {
    content: '';
    position: absolute;
    top: calc(var(--space-8) + 0.6em);
    inset-inline-start: calc(var(--space-8) * -1);
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--bg);
  }

  /* Older roles read as history, not as the current one. */
  .job:not(:first-child)::before {
    background: var(--border-strong);
  }

  .job__period {
    padding-top: 0.35em;
  }

  .job__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .job__org {
    font-weight: 500;
  }

  .job__achievements {
    padding-inline-start: 1.25em;
  }

  .stack-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-top: var(--space-16);
    /* Same indent as the timeline, so both blocks share one left edge. */
    padding-inline-start: var(--space-8);
  }

  .stack-groups {
    display: grid;
    gap: var(--space-6);
  }

  .stack-group {
    display: grid;
    gap: var(--space-3);
  }

  .stack-group dd {
    margin: 0;
  }

  .stack-group__items {
    --cluster-gap: var(--space-2);
  }

  /* The period and the group labels only need room for their own text: anything wider
     leaves a gap the eye has to jump across to reach the content. */
  @media (min-width: 600px) {
    .job,
    .stack-group {
      grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
    }

    .stack-group dt {
      padding-top: 0.3em;
    }
  }

  @media (min-width: 1024px) {
    .job,
    .stack-group {
      grid-template-columns: minmax(0, 11rem) minmax(0, 1fr);
    }
  }
</style>

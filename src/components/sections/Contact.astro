---
import Section from '../layout/Section.astro';
import Icon from '../ui/Icon.astro';
import Pending from '../ui/Pending.astro';
import { useTranslations, type Lang } from '../../i18n/ui';
import { pick, single } from '../../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const contact = await single('contact');
const site = await single('site');

const networks = contact.networks
  .map((network) => ({ ...network, href: site.links[network.key] }))
  .filter((network) => !!network.href);
const missing = contact.networks.filter((network) => !site.links[network.key]).map((network) => network.label);
---

<Section name="contact" lang={lang}>
  <div class="contact">
    <div class="contact__copy">
      <p class="contact__title">{pick(contact.title, lang)}</p>
      <p class="lead">{pick(contact.body, lang)}</p>
      {site.email && <p class="contact__email mono">{site.email}</p>}
      {missing.length > 0 && <Pending label={`Faltan enlaces: ${missing.join(', ')}.`} />}
    </div>

    <div class="contact__links">
      <h3 class="label">{pick(contact.linksTitle, lang)}</h3>
      <ul role="list">
        {
          networks.map((network) => (
            <li>
              <a class="contact__link" href={network.href}>
                <span class="contact__label">{network.label}</span>
                {network.handle && <span class="contact__handle mono">{network.handle}</span>}
                <span class="sr-only">{t('link.external')}</span>
                <Icon name="arrow-up-right" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

<style>
  .contact {
    display: grid;
    gap: var(--space-12) var(--gutter);
  }

  .contact__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__title {
    font-family: var(--font-display-stack);
    font-size: var(--fs-h2);
    line-height: var(--lh-h2);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    max-width: 18ch;
    text-wrap: balance;
  }

  .contact__email {
    color: var(--accent);
  }

  .contact__links {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .contact__link {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    min-height: 3.5rem;
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border-subtle);
    color: var(--text);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease);
  }

  .contact__links li:first-child .contact__link {
    border-top: 1px solid var(--border-subtle);
  }

  .contact__label {
    font-family: var(--font-display-stack);
    font-size: var(--fs-h3);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .contact__handle {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .contact__link :global(.icon) {
    margin-inline-start: auto;
    align-self: center;
    color: var(--text-muted);
  }

  .contact__link:hover {
    color: var(--accent);
  }

  .contact__link:hover :global(.icon) {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .contact__link :global(.icon) {
      transition:
        transform var(--dur-2) var(--ease),
        color var(--dur-2) var(--ease);
    }

    .contact__link:hover :global(.icon) {
      transform: translate(2px, -2px);
    }
  }

  @media (min-width: 1024px) {
    .contact {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: var(--space-16);
      align-items: start;
    }
  }
</style>

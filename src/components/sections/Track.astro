---
import Section from '../layout/Section.astro';
import Scoreboard from '../blocks/Scoreboard.astro';
import TextLink from '../ui/TextLink.astro';
import type { Lang } from '../../i18n/ui';
import { pick, single } from '../../lib/content';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const track = await single('track');
---

<Section name="track" lang={lang}>
  <Scoreboard
    caption={pick(track.caption, lang)}
    columns={{
      year: pick(track.columns.year, lang),
      event: pick(track.columns.event, lang),
      place: pick(track.columns.place, lang),
      role: pick(track.columns.role, lang),
    }}
    rows={track.rows.map((row) => ({
      year: row.year,
      event: pick(row.event, lang),
      place: row.place,
      role: pick(row.role, lang),
      highlight: row.highlight,
    }))}
  />
  <p class="track__profile">
    <TextLink href={track.profile.url} external lang={lang}>{pick(track.profile.label, lang)}</TextLink>
  </p>
</Section>

<style>
  .track__profile {
    margin-top: var(--space-6);
  }

  .track__profile :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    font-weight: 600;
  }
</style>

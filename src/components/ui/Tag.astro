---
interface Props {
  as?: 'li' | 'span';
}

const { as: Element = 'li' } = Astro.props as Props;
---

<Element class="tag"><slot /></Element>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem var(--space-3);
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: var(--surface-2);
    font-family: var(--font-mono-stack);
    font-size: var(--fs-label);
    line-height: 1.6;
    color: var(--text-muted);
  }
</style>

---
interface Props {
  letter: string;
  title: string;
  /** Short mono line above the title, e.g. the section's time span. */
  meta?: string;
  id?: string;
}

const { letter, title, meta, id } = Astro.props;
---

<header class="section-header">
  {meta && <p class="label">{meta}</p>}
  <h2 id={id}>
    <span class="section-header__letter" aria-hidden="true">{letter}</span>
    <span class="sr-only">{letter}.</span>
    {title}
  </h2>
  <slot />
</header>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin-bottom: var(--space-12);
  }

  h2 {
    display: flex;
    align-items: baseline;
    gap: 0.4em;
  }

  .section-header__letter {
    font-family: var(--font-mono-stack);
    font-size: 0.5em;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--accent-text);
    transform: translateY(-0.15em);
  }
</style>

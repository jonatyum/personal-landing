---
interface Props {
  title: string;
  /** Short mono line above the title; defaults to the title itself. */
  meta?: string;
  id?: string;
}

const { title, meta, id } = Astro.props;
---

<header class="section-header">
  <p class="label section-header__meta">
    <span class="section-header__rule" aria-hidden="true"></span>
    {meta ?? title}
  </p>
  <h2 id={id}>{title}</h2>
  <slot />
</header>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-12);
  }

  .section-header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--accent);
  }

  .section-header__rule {
    width: 2rem;
    height: 1px;
    background: currentColor;
  }

  h2 {
    max-width: 20ch;
  }
</style>

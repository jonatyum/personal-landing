---
interface Props {
  title: string;
  /** Short mono line above the title; defaults to the title itself. */
  meta?: string;
  /** Two-digit index shown before the meta line. Decorative. */
  number?: string;
  id?: string;
}

const { title, meta, number, id } = Astro.props;
---

<header class="section-header">
  <p class="label section-header__meta">
    {number && <span class="section-header__number" aria-hidden="true">{number}</span>}
    <span class="section-header__rule" aria-hidden="true"></span>
    {meta ?? title}
  </p>
  <h2 id={id}>{title}</h2>
  <slot />
</header>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  .section-header__meta {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--accent);
  }

  .section-header__number {
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .section-header__rule {
    width: 2rem;
    height: 1px;
    background: currentColor;
    transform-origin: 0 50%;
  }

  /* The rule grows out of the number as the heading enters the viewport. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .section-header__rule {
        scale: 0 1;
        animation-name: rule-grow;
        animation-duration: auto;
        animation-fill-mode: both;
        animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
        animation-timeline: view();
        animation-range: entry 25% entry 90%;
      }
    }
  }

  @keyframes rule-grow {
    to {
      scale: 1 1;
    }
  }

  h2 {
    max-width: 20ch;
  }
</style>

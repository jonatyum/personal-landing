---
// Marks missing content during development. Renders nothing in production builds,
// and check-dist fails if the marker ever reaches dist/.
interface Props {
  label: string;
}

const { label } = Astro.props;
---

{
  import.meta.env.DEV && (
    <div class="pending" role="note">
      <span class="label">PENDIENTE</span>
      <span>{label}</span>
    </div>
  )
}

<style>
  .pending {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-3);
    align-items: baseline;
    padding: var(--space-4);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-2);
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  .pending .label {
    color: var(--accent);
  }
</style>
